{
  "name": "mcp-production-kit",
  "version": "1.0.0",
  "description": "Production-grade, type-safe Model Context Protocol (MCP) server boilerplate with dual transports, security guards, and enterprise tools.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "start:stdio": "node --experimental-strip-types src/index.ts --transport=stdio",
    "start:sse": "node --experimental-strip-types src/index.ts --transport=sse --port=3000",
    "build": "tsc",
    "test": "node --experimental-strip-types tests/server.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "cursor",
    "ai-agents",
    "typescript"
  ],
  "author": "Antigravity Autonomous Lab",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
